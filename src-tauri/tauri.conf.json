{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "ADHD Tools",
  "version": "1.0.0",
  "identifier": "com.adhdtools.desktop",
  "build": {
    "beforeDevCommand": "node .claude/static-server.cjs",
    "beforeBuildCommand": "node scripts/prepare-desktop.cjs",
    "devUrl": "http://localhost:8422",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "ADHD Tools Hub",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 500
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
